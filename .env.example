# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Stripe (Developers -> API keys)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Sarcina E — cheia publica, folosita in browser de Express Checkout Element
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# URL-ul public al site-ului (fara / la final)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# optional — email de confirmare (Resend, resend.com/api-keys)
RESEND_API_KEY=re_...
# Sarcina G — domeniu verificat in Resend (fara asta, sandbox-ul Resend
# accepta doar adresa proprie a contului)
RESEND_FROM_EMAIL="12 ROUNDS <no-reply@mail.12rounds.ro>"

# obligatoriu — protejeaza /overlay si /overlay/[slug] (?key=...); genereaza-l
# o singura data cu: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
OVERLAY_SECRET=

# Gate "revenim in curand" (src/middleware.ts) — blocheaza tot site-ul public
# pana la lansare. SITE_ACCESS_PASSWORD e parola introdusa de vizitator;
# SITE_ACCESS_TOKEN e un secret separat pentru cookie, generat la fel ca mai sus.
SITE_ACCESS_PASSWORD=
SITE_ACCESS_TOKEN=
